{
    "compilerOptions": {
        // Type checking
        "noImplicitOverride": true,
        "strict": true,

        // Modules
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [],

        // Emit
        "declaration": true,
        "noEmit": true,
        "outDir": "dist",
        "sourceMap": true,

        // Language and Environment
        "jsx": "react-jsx",
        "jsxImportSource": ".",
        "target": "es2024",

        // Output formatting
        "noErrorTruncation": true,
    },
}
